# Road Disruption Intelligence – example configuration.
# Copy to ".env" (same folder) and edit. ".env" is gitignored. NEVER put real keys in this example file.
# All settings are optional; the defaults below are safe for a single local computer.

# ---- Network binding --------------------------------------------------------
# Local only by default. To expose on a network you must set BOTH of the next two lines.
APP_HOST=127.0.0.1
APP_PORT=8000
# APP_ALLOW_REMOTE=true
# APP_ACCESS_TOKEN=replace-with-a-long-random-string-of-at-least-16-characters

# ---- Data locations -------------------------------------------------------------
# Defaults: historical data in ./data or ../data; database, logs, backups in ./runtime
# HISTORICAL_DATA_DIR=D:\path\to\data
# RUNTIME_DIR=D:\path\to\runtime

# ---- Background work ------------------------------------------------------------
SCHEDULER_ENABLED=true
JOB_WORKERS=2

# ---- Geocoding --------------------------------------------------------------------
# Online lookups use OpenStreetMap Nominatim (max 1 request/second, results cached).
# Set false to use only the built-in offline city/state gazetteer.
GEOCODING_ONLINE=true
# Contact e-mail sent in the Nominatim User-Agent, as their usage policy requests.
NOMINATIM_CONTACT_EMAIL=
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# ---- Optional API keys (can also be entered in the web UI) -------------------------
# Environment values take precedence over keys entered in the UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NEWSAPI_KEY=
GNEWS_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

LOG_LEVEL=INFO
